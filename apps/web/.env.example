# Local Supabase API (from `supabase start` in packages/db).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the publishable key from `supabase status -o env` (PUBLISHABLE_KEY) into your own .env.local.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sentry error reports. Leave it empty locally. It is read only by a production build, from the Vercel production environment.
NEXT_PUBLIC_SENTRY_DSN=
