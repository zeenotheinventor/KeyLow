{
  "extends": "@keylow/config/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "test/**/*",
    "e2e/**/*",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mjs",
    "*.mts"
  ]
}
