{
  "keyframes": {
    "punch": {
      "from": {
        "opacity": "0",
        "transform": "scale(1.14)"
      },
      "55%": {
        "opacity": "1",
        "transform": "scale(0.97)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    }
  },
  "animation": {
    "punch": "punch {transitionDuration.flourish} {transitionTimingFunction.enter} both"
  }
}
