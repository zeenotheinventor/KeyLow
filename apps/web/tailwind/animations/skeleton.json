{
  "keyframes": {
    "shimmer": {
      "from": {
        "backgroundPosition": "200% 0"
      },
      "to": {
        "backgroundPosition": "-200% 0"
      }
    },
    "skeleton-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    }
  },
  "animation": {
    "skeleton": "shimmer 1400ms linear infinite, skeleton-in 160ms ease both"
  }
}
