{
  "expo": {
    "name": "Ki-Lo",
    "slug": "keylow",
    "scheme": "keylow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cd8bec0b-6864-4b6f-97ef-e07d1a381b3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sojisoft.keylow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sojisoft.keylow",
      "backgroundColor": "#0B0E13",
      "permissions": ["android.permission.health.READ_WEIGHT"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.127670518185-ni3pj7ngsfunqnqr5mmsd7bvmjp7ooi8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ki-Lo uses the camera to scan food barcodes so you can look up a product without typing.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E13",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ki-Lo reads your weight from Apple Health so your weigh-ins appear in your trend without typing them twice.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-system-ui",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "sojisoft-limited",
          "project": "keylow-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cd8bec0b-6864-4b6f-97ef-e07d1a381b3a"
      }
    },
    "owner": "sojisoft"
  }
}
