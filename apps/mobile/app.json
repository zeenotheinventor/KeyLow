{
  "expo": {
    "name": "Ki-Lo",
    "slug": "keylow",
    "scheme": "keylow",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cd8bec0b-6864-4b6f-97ef-e07d1a381b3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sojisoft.keylow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sojisoft.keylow",
      "backgroundColor": "#0B0E13",
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.127670518185-ni3pj7ngsfunqnqr5mmsd7bvmjp7ooi8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ki-Lo uses the camera to scan food barcodes so you can look up a product without typing.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E13",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ki-Lo reads your weight from Apple Health so your weigh-ins appear in your trend without typing them twice.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#CCF249"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayRing",
              "label": "Today ring",
              "description": "Calories left today, as a ring.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/today-ring.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayMacros",
              "label": "Today with macros",
              "description": "Calories left today, with protein, carbs and fat.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/today-macros.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ThisWeek",
              "label": "This week",
              "description": "Your average this week and the days you completed.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/this-week.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BodyHeat",
              "label": "Body heat",
              "description": "The three warmest muscles right now.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/body-heat.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayGlance",
              "label": "Today at a glance",
              "description": "Today, this week and training in one widget.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/today-glance.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BodyMap",
              "label": "Body map",
              "description": "Your body map on heat or weekly volume, as set in More.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/body-map.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "sojisoft-limited",
          "project": "keylow-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cd8bec0b-6864-4b6f-97ef-e07d1a381b3a"
      }
    },
    "owner": "sojisoft"
  }
}
