# Copy to .env.local (ignored by git) and fill in. The values come from `supabase status -o env`.
# A phone cannot reach localhost, so use this machine's LAN IP in the URL.
EXPO_PUBLIC_SUPABASE_URL=http://<your-lan-ip>:54321
# Use PUBLISHABLE_KEY from `supabase status -o env`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google sign-in client ids, created in Google Cloud and listed under Authorized Client IDs in the
# Supabase Google provider (KEY-12). Both are needed. Without them the Google button shows an error
# and email sign-in keeps working.
# The iOS client id (Google Cloud project KeyLow, client "KeyLow iOS", bundle com.sojisoft.keylow). Its
# reversed form is the iosUrlScheme in app.json; keep the two in sync.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=127670518185-ni3pj7ngsfunqnqr5mmsd7bvmjp7ooi8.apps.googleusercontent.com
# The web client id. It is the audience of the ID token on both platforms (the iOS native config
# sets serverClientID to it), so list it under Authorized Client IDs as well as the iOS client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=127670518185-hp20gpd441vf5j74b1bt5u23vvsock8e.apps.googleusercontent.com
