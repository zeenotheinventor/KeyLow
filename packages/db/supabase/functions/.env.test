# Test configuration for `supabase functions serve --env-file supabase/functions/.env.test`.
# Committed on purpose: it holds no secrets.

# The OFF mock server the integration tests start on the host. Functions run in a container, so
# they reach the host through host.docker.internal.
OFF_BASE_URL=http://host.docker.internal:54399

# Open Food Facts requires a User-Agent. This one is for tests only.
OFF_USER_AGENT=KeyLow-test/0.0 (test@keylow.local)

# Limits are small so that a test reaches them in a few calls. Each is a count per minute. A global
# limit is three times its per-user limit, so two parallel test files cannot exhaust a global bucket
# just by reaching their own per-user limit.
# The off-search limit per signed-in user.
OFF_SEARCH_PER_USER_PER_MIN=3
# The off-search limit across all users.
OFF_SEARCH_GLOBAL_PER_MIN=9
# The off-product limit per signed-in user.
OFF_PRODUCT_PER_USER_PER_MIN=5
# The off-product limit across all users.
OFF_PRODUCT_GLOBAL_PER_MIN=15
