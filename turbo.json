{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "format:check": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VERCEL_ENV", "VERCEL_GIT_COMMIT_SHA"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "//#generate:lists": {
      "outputs": [],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "bundle-core-for-deno": {
      "outputs": [],
      "cache": false
    },
    "check:functions": {
      "dependsOn": ["bundle-core-for-deno"],
      "outputs": [],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": [],
      "cache": false
    }
  }
}
