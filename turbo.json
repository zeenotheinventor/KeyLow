{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "format:check": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": ["coverage/**"]
    },
    "bundle-core-for-deno": {
      "outputs": [],
      "cache": false
    },
    "check:functions": {
      "dependsOn": ["bundle-core-for-deno"],
      "outputs": [],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^typecheck", "^test:integration"],
      "outputs": [],
      "cache": false
    }
  }
}
