# EAS reads this file INSTEAD of every .gitignore, so the first block repeats the root and apps/mobile ignore rules.
# EAS looks for it at the git root, not the app directory.

# From the root .gitignore
node_modules/
.pnpm-store/
.turbo/
apps/*/.expo/
apps/*/.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
apps/*/.next/
apps/*/out/
packages/db/supabase/.branches/
packages/db/supabase/.temp/
packages/db/supabase/functions/_shared/core/
packages/db/supabase/functions/_shared/repos/
dist/
# The phone's 3D body model and its licence notice are committed here and the app bundles them
!/tools/body-model/dist/
build/
coverage/
.env
.env.local
.env.*.local
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# From apps/mobile/.gitignore
/apps/mobile/ios/
/apps/mobile/android/

# Not needed to build the app (ADR 0001)
/apps/web/
/docs/
/packages/db/data/
e2e/
/.github/

# Left in a developer's checkout by tools, never part of the app. The desktop app keeps its session
# worktrees under .claude/, which are whole copies of the repository, and a Supabase CLI run from the
# repository root leaves supabase/.temp. Neither is tracked, so without these lines a build from such a
# checkout uploads them (KEY-1109).
/.claude/
/supabase/
