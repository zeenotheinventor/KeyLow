{
  "name": "keylow",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "turbo run format:check lint typecheck test",
    "check:ci": "sh -c 'turbo run format:check lint typecheck test --filter=!@keylow/web \"$@\" && turbo run format:check lint typecheck --filter=@keylow/web \"$@\"' check:ci",
    "check:integration": "turbo run check:functions test:integration",
    "dev:db": "pnpm --filter @keylow/db run dev:db",
    "format:check": "prettier --check .",
    "generate:lists": "node --experimental-strip-types --no-warnings tools/generate-lists/src/run.ts",
    "gen-types": "pnpm --filter @keylow/db run gen-types",
    "mobile:dev": "git pull --ff-only && pnpm install && pnpm --filter @keylow/mobile start --clear",
    "storybook": "pnpm --filter @keylow/web run storybook"
  },
  "devDependencies": {
    "@keylow/config": "workspace:*",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "lefthook"
    ],
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "postcss-loader": "8.1.1"
    }
  },
  "prettier": "@keylow/config/prettier"
}
