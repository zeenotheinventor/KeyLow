{
  "name": "keylow",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "turbo run format:check lint typecheck test",
    "check:integration": "turbo run check:functions test:integration",
    "dev:db": "pnpm --filter @keylow/db run dev:db",
    "format:check": "prettier --check .",
    "gen-types": "pnpm --filter @keylow/db run gen-types"
  },
  "devDependencies": {
    "@keylow/config": "workspace:*",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "postcss-loader": "8.1.1"
    }
  },
  "prettier": "@keylow/config/prettier"
}
